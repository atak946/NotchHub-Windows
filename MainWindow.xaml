<Window x:Class="Notch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" Width="780" Height="272"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{StaticResource Fg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid">
        <Grid x:Name="NotchHost" HorizontalAlignment="Center" VerticalAlignment="Top"
              MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave"
              MouseLeftButtonUp="Notch_Click" AllowDrop="True"
              DragEnter="Notch_DragEnter" DragOver="Notch_DragOver" DragLeave="Notch_DragLeave" Drop="Notch_Drop">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="NotchScaleT" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <Path x:Name="Shape" Fill="#000000">
            </Path>

            <Grid x:Name="Body">

                <!-- ============ BOSTA ============ -->
                <Grid x:Name="IdleView" Margin="24,0,24,0">
                    <Border x:Name="IdleArt" Width="18" Height="18" CornerRadius="5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="IdleArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="IdleLeftIcon" Style="{StaticResource Icon}" FontSize="13"
                               HorizontalAlignment="Left" Foreground="{DynamicResource Accent}"
                               Text="&#xE916;" Visibility="Collapsed"/>
                    <TextBlock x:Name="IdleClock" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="IdleHud" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="IdleMeeting" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#BF5AF2"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="IdleFocus" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                               Text="&#xE708;" Foreground="#5E5CE6" Visibility="Collapsed" ToolTip="Odak modu"/>
                    <Ellipse x:Name="IdleCam" Width="7" Height="7" Fill="#30D158" Margin="0,0,8,0"
                             VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="IdleMic" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"
                               Text="&#xE720;" Foreground="#FF9F0A" Visibility="Collapsed"/>
                    <TextBlock x:Name="IdleWeather" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel x:Name="EqBars" Orientation="Horizontal"
                                VerticalAlignment="Center" Height="14" Visibility="Collapsed">
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Height="6" VerticalAlignment="Center" Fill="{DynamicResource Accent}"/>
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Accent}"/>
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Accent}"/>
                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Height="12" VerticalAlignment="Center" Fill="{DynamicResource Accent}"/>
                    </StackPanel>
                    <TextBlock x:Name="IdleTimer" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- ============ SES ============ -->
                <Grid x:Name="VolumeView" Margin="26,0,26,0" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VolIcon" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,14,0" Text="&#xE995;"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="VolName" Style="{StaticResource Sub}" Margin="0,0,0,7"/>
                        <Grid Height="5">
                            <Border Background="{StaticResource Track}" CornerRadius="2.5"/>
                            <Border x:Name="VolFill" Background="{DynamicResource Accent}" CornerRadius="2.5"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="VolScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="VolValue" Grid.Column="2" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               FontWeight="SemiBold" MinWidth="46" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>

                <!-- ============ BILDIRIM ============ -->
                <Grid x:Name="ToastView" Margin="24,0,26,0" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border x:Name="ToastArt" CornerRadius="9">
                            <Border.Background>
                                <ImageBrush x:Name="ToastArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ToastIconBg" CornerRadius="20" Background="#26FF5A1F">
                            <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="17"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastSub" Style="{StaticResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ============ GENIS PANEL ============ -->
                <Grid x:Name="ExpandedView" Margin="28,0,28,16" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Baslik -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HdrClock" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HdrDate" Style="{StaticResource Sub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="HdrVolume" Style="{StaticResource Sub}" HorizontalAlignment="Left" Margin="52,0,0,0"
                               VerticalAlignment="Center" Opacity="0" Foreground="{StaticResource Fg}" Background="Black"
                               Padding="0,0,12,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="FocusBtn" Style="{StaticResource IconButton}" Content="&#xE708;" FontSize="13" Width="28" Height="26"
                                Foreground="{StaticResource SubFg}" ToolTip="Odak modu" Margin="0,0,2,0" Click="Focus_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13" Width="28" Height="26"
                                Foreground="{StaticResource SubFg}" ToolTip="Ayarlar" Margin="0,0,6,0" Click="Settings_Click"/>
                        <RadioButton x:Name="TabMedia" Style="{StaticResource Tab}" Content="&#xE8D6;" ToolTip="Medya" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAudio" Style="{StaticResource Tab}" Content="&#xE767;" ToolTip="Ses karıştırıcı" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabCal" Style="{StaticResource Tab}" Content="&#xE787;" ToolTip="Takvim ve hava" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAgenda" Style="{StaticResource Tab}" Content="&#xE823;" ToolTip="Ajanda (Outlook)" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSys" Style="{StaticResource Tab}" Content="&#xE9D9;" ToolTip="Sistem" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabDevices" Style="{StaticResource Tab}" Content="&#xE702;" ToolTip="Cihazlar ve pil" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabTools" Style="{StaticResource Tab}" Content="&#xE916;" ToolTip="Zamanlayıcı" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabClip" Style="{StaticResource Tab}" Content="&#xE77F;" ToolTip="Pano geçmişi" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabTray" Style="{StaticResource Tab}" Content="&#xE8B7;" ToolTip="Saklama tepsisi" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabNotes" Style="{StaticResource Tab}" Content="&#xE70B;" ToolTip="Notlar" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabHistory" Style="{StaticResource Tab}" Content="&#xEA8F;" ToolTip="Bildirim geçmişi" Checked="Tab_Checked"/>
                    </StackPanel>

                    <!-- Medya -->
                    <Grid x:Name="PanelMedia" Grid.Row="1">
                        <Grid x:Name="MediaContent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MediaArt" Width="128" Height="128" CornerRadius="16" Background="#1AFFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="MediaArtPlaceholder" Style="{StaticResource Icon}" Text="&#xE8D6;"
                                           FontSize="34" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaApp" Style="{StaticResource Sub}" FontSize="10.5"/>
                                <TextBlock x:Name="MediaTitle" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaArtist" Style="{StaticResource Sub}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaLyric" Foreground="{DynamicResource Accent}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <Grid x:Name="MediaSeek" Height="14" Margin="0,5,0,0" Background="Transparent" Cursor="Hand"
                                      ToolTip="Tıkla: bu noktaya atla" MouseLeftButtonUp="MediaSeek_Click">
                                <Grid Height="4" VerticalAlignment="Center">
                                    <Border Background="{StaticResource Track}" CornerRadius="2"/>
                                    <Border x:Name="MediaFill" Background="{DynamicResource Accent}" CornerRadius="2"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="MediaScale" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                </Grid>
                                <Grid>
                                    <TextBlock x:Name="MediaPos" Style="{StaticResource Sub}" FontSize="10.5"/>
                                    <TextBlock x:Name="MediaDur" Style="{StaticResource Sub}" FontSize="10.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;"
                                            Width="44" Height="44" FontSize="22" Margin="10,0" Click="Play_Click"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="MediaEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="30" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Şu an bir şey çalmıyor" FontSize="13" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Takvim -->
                    <Grid x:Name="PanelCal" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Style="{StaticResource TileBorder}" Margin="14,4,0,4">
                            <Grid>
                                <StackPanel x:Name="WxContent">
                                    <TextBlock x:Name="WxCity" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="WxIcon" FontFamily="Segoe UI Emoji" FontSize="26" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="WxTemp" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                                   FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WxDesc" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WxDetail" Style="{StaticResource Sub}" FontSize="10.5" Margin="0,2,0,8"/>
                                    <UniformGrid x:Name="WxHours" Columns="4"/>
                                </StackPanel>
                                <TextBlock x:Name="WxEmpty" Style="{StaticResource Sub}" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Text="Hava durumu için Ayarlar'dan şehir gir"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CalDayName" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="CalDayNum" FontFamily="{StaticResource DisplayFont}" FontSize="64"
                                       FontWeight="SemiBold" Margin="0,-6,0,-6"/>
                            <TextBlock x:Name="CalMonthYear" Style="{StaticResource Sub}" FontSize="13"/>
                            <TextBlock x:Name="CalWeek" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CalGridTitle" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE76B;" Click="CalPrev_Click"/>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE76C;" Click="CalNext_Click"/>
                            </StackPanel>
                            <UniformGrid x:Name="CalGrid" Grid.Row="1" Columns="7" Rows="7" Margin="0,4,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- Sistem -->
                    <UniformGrid x:Name="PanelSys" Grid.Row="1" Columns="4" Visibility="Collapsed">
                        <Border Style="{StaticResource TileBorder}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="CPU"/>
                                    <TextBlock x:Name="CpuVal" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Text="–"/>
                                </StackPanel>
                                <Polyline x:Name="CpuSpark" VerticalAlignment="Bottom" Height="48" Stroke="{DynamicResource Accent}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="None"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="GPU"/>
                                    <TextBlock x:Name="GpuVal" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Text="–"/>
                                    <TextBlock x:Name="GpuDetail" Style="{StaticResource Sub}" FontSize="10.5"/>
                                </StackPanel>
                                <Polyline x:Name="GpuSpark" VerticalAlignment="Bottom" Height="48" Stroke="#4FC3F7"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="None"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="RAM"/>
                                    <TextBlock x:Name="RamVal" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Text="–"/>
                                    <TextBlock x:Name="RamDetail" Style="{StaticResource Sub}" FontSize="10.5"/>
                                </StackPanel>
                                <Polyline x:Name="RamSpark" VerticalAlignment="Bottom" Height="40" Stroke="#B388FF"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="None"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TileBorder}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="AĞ"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Foreground="#69F0AE" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="NetDown" FontWeight="SemiBold" FontSize="14" Text="–"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="11" Foreground="#FFD54F" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="NetUp" FontWeight="SemiBold" FontSize="14" Text="–"/>
                                    </StackPanel>
                                </StackPanel>
                                <Polyline x:Name="NetSpark" VerticalAlignment="Bottom" Height="40" Stroke="#69F0AE"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="None"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Saklama tepsisi -->
                    <Grid x:Name="PanelTray" Grid.Row="1" Visibility="Collapsed">
                        <Border x:Name="TrayDropZone" CornerRadius="16" BorderThickness="1.5" Margin="4"
                                Background="#0DFFFFFF">
                            <Border.BorderBrush>
                                <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#40FFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,5,5"/>
                                                    <RectangleGeometry Rect="5,5,5,5"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <StackPanel x:Name="TrayEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrayEmptyIcon" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="28"
                                               HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
                                    <TextBlock x:Name="TrayEmptyText" Style="{StaticResource Sub}" Text="Dosyaları buraya sürükle" FontSize="13"
                                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Sub}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                               Text="Dosyalar yerinde kalır, burada sadece kısayolu tutulur"/>
                                </StackPanel>
                                <DockPanel x:Name="TrayContent" Margin="10,8,10,6">
                                    <Grid DockPanel.Dock="Top" Margin="2,0,0,4">
                                        <TextBlock x:Name="TrayCount" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="TrayDragAll" Style="{StaticResource PillButton}" Content="Tümünü sürükle"
                                                    Margin="0,0,6,0" PreviewMouseLeftButtonDown="TrayDragAll_Down"
                                                    PreviewMouseMove="TrayDragAll_Move"/>
                                            <Button Style="{StaticResource PillButton}" Content="Temizle" Margin="0" Click="TrayClear_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer x:Name="TrayScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="TrayScroll_Wheel">
                                        <StackPanel x:Name="TrayList" Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Ses karistirici -->
                    <Grid x:Name="PanelAudio" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Sonar GAME profilleri: Sonar calismiyorsa gizli -->
                        <DockPanel x:Name="SonarBar" Grid.ColumnSpan="2" Margin="10,2,4,2" Height="28" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Sub}" Text="Game profili" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="SonarMoreBtn" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Diğer"
                                    Margin="6,0,0,0" VerticalAlignment="Center" Click="SonarMore_Click"/>
                            <ScrollViewer x:Name="SonarFavScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="SonarFav_Wheel" VerticalAlignment="Center">
                                <StackPanel x:Name="SonarFavList" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Tum profiller ("Diger"): alttaki karistiricinin yerine acilir -->
                        <Border x:Name="SonarAll" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="1" Style="{StaticResource TileBorder}"
                                Padding="10,8,6,4" Visibility="Collapsed">
                            <ScrollViewer x:Name="SonarAllScroll" VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Text="Profillerin" Margin="2,0,0,5"/>
                                    <WrapPanel x:Name="SonarOwnList"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="Hazır profiller" Margin="2,4,0,5"/>
                                    <WrapPanel x:Name="SonarPresetList"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="MixerLeft" Grid.Row="1" Style="{StaticResource TileBorder}" Padding="8,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" CornerRadius="10" Padding="6,4" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="MicBtn" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="14"
                                                Content="&#xE720;" Click="Mic_Click"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock x:Name="MicName" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="MicState" Style="{StaticResource Sub}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Çıkış cihazı" Margin="6,0,0,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="OutList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border x:Name="MixerRight" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileBorder}" Padding="10,8,6,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="Uygulamalar" Margin="4,0,0,4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="AppList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Cihazlar -->
                    <Grid x:Name="PanelDevices" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <StackPanel x:Name="BrightnessList"/>
                                <WrapPanel x:Name="DeviceList"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE702;" FontSize="28" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Pil bilgisi bildiren cihaz bulunamadı" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Sub}" FontSize="10.5" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Text="Bluetooth kulaklık/mouse/klavyeler gösterilir; 2.4 GHz alıcılı cihazların pili Windows'a bildirilmez"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ajanda -->
                    <Grid x:Name="PanelAgenda" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer x:Name="AgendaScroll" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="AgendaList"/>
                        </ScrollViewer>
                        <StackPanel x:Name="AgendaEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="28" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                            <TextBlock x:Name="AgendaEmptyText" Style="{StaticResource Sub}" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"
                                       Text="Bugün ve yarın için etkinlik yok"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bildirim gecmisi -->
                    <Grid x:Name="PanelHistory" Grid.Row="1" Visibility="Collapsed">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                                <TextBlock x:Name="HistoryHeader" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillButton}" Content="Temizle" Margin="0" HorizontalAlignment="Right" Click="HistoryClear_Click"/>
                            </Grid>
                            <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="HistoryList"/>
                            </ScrollViewer>
                        </DockPanel>
                        <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="28" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                            <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,10,0,0" Text="Henüz bildirim yok"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notlar -->
                    <Grid x:Name="PanelNotes" Grid.Row="1" Visibility="Collapsed">
                        <Border Style="{StaticResource TileBorder}" Padding="14,10">
                            <Grid>
                                <TextBox x:Name="NotesBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                                         CaretBrush="{DynamicResource Accent}" FontSize="13.5" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden"
                                         PreviewMouseLeftButtonDown="Notes_MouseDown" TextChanged="Notes_TextChanged"/>
                                <TextBlock x:Name="NotesHint" Style="{StaticResource Sub}" FontSize="13.5" IsHitTestVisible="False"
                                           Text="Not almak için tıkla… (otomatik kaydedilir)" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Zamanlayici -->
                    <Grid x:Name="PanelTools" Grid.Row="1" Visibility="Collapsed">
                        <Border Style="{StaticResource TileBorder}" Padding="22,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ModeTimerBtn" Style="{StaticResource PillButton}" Content="Zamanlayıcı" Height="24" Click="ModeTimer_Click"/>
                                        <Button x:Name="ModePomoBtn" Style="{StaticResource PillButton}" Content="Pomodoro" Height="24" Click="ModePomo_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerTitle" Style="{StaticResource Sub}" Margin="2,2,0,0"/>
                                    <TextBlock x:Name="TimerText" FontFamily="{StaticResource DisplayFont}" FontSize="58"
                                               FontWeight="SemiBold" Text="00:00" Margin="0,-4,0,2"/>
                                    <Grid Height="5" Width="230" HorizontalAlignment="Left">
                                        <Border Background="{StaticResource Track}" CornerRadius="2.5"/>
                                        <Border x:Name="TimerFill" Background="{DynamicResource Accent}" CornerRadius="2.5"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="TimerScale" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="250">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                        <Button x:Name="TimerPlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                Width="48" Height="48" FontSize="20" Background="#1AFFFFFF" Click="TimerPlay_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Sıfırla"
                                                Width="48" Height="48" FontSize="17" Margin="10,0,0,0" Click="TimerReset_Click"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="TimerPresets" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource PillButton}" Content="1 dk" Tag="1" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="5 dk" Tag="5" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="10 dk" Tag="10" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="15 dk" Tag="15" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="25 dk" Tag="25" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="45 dk" Tag="45" Click="TimerPreset_Click"/>
                                        <Button Style="{StaticResource PillButton}" Content="+1 dk" Tag="+1" Click="TimerPreset_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Pano gecmisi -->
                    <Grid x:Name="PanelClip" Grid.Row="1" Visibility="Collapsed">
                        <Border Style="{StaticResource TileBorder}" Padding="10,8,6,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="6,0,4,4">
                                    <TextBlock x:Name="ClipHeader" Style="{StaticResource Sub}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                                    <Button x:Name="ClipClearBtn" Style="{StaticResource PillButton}" Content="Temizle" Margin="0"
                                            HorizontalAlignment="Right" Click="ClipClear_Click"/>
                                </Grid>
                                <StackPanel x:Name="ClipEmpty" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="26" HorizontalAlignment="Center" Foreground="#55FFFFFF"/>
                                    <TextBlock Style="{StaticResource Sub}" Text="Henüz bir şey kopyalanmadı" FontSize="13" Margin="0,8,0,0"/>
                                </StackPanel>
                                <ScrollViewer x:Name="ClipScroll" VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="ClipList"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
